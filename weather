<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notion Weather Widget</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* 隐藏滚动条，让组件在 Notion 中更干净 */
        body::-webkit-scrollbar { display: none; }
        body { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-transparent text-gray-800 transition-colors duration-300">

    <div id="weather-card" class="p-4 rounded-xl border border-gray-200 bg-white/80 backdrop-blur-md shadow-sm max-w-sm mx-auto flex items-center justify-between">
        <div>
            <h2 id="location" class="text-lg font-bold text-gray-700">加载中...</h2>
            <p id="condition" class="text-sm text-gray-500">正在获取天气数据</p>
        </div>
        <div class="text-right">
            <span id="temp" class="text-3xl font-extrabold text-gray-900">--</span>
            <span class="text-xl font-medium text-gray-500">°C</span>
        </div>
    </div>

    <script>
        // 配置你的 API 参数
        const API_KEY = '7c45462873e1494dbaef5d2a936cc342'; // 替换为你的和风天气 KEY
        const LOCATION_ID = '101280601'; // 示例：深圳的 Location ID，也可以使用经纬度 "114.05,22.54"

        // 1. 异步获取天气数据
        async function fetchWeather() {
            try {
                const url = `https://devapi.qweather.com/v7/weather/now?location=${LOCATION_ID}&key=${API_KEY}`;
                const response = await fetch(url);
                const data = await response.json();

                if (data.code === '200') {
                    updateUI(data.now);
                } else {
                    document.getElementById('condition').innerText = '数据加载失败';
                }
            } catch (error) {
                console.error('Fetch error:', error);
            }
        }

        // 2. 渲染数据到页面
        function updateUI(now) {
            document.getElementById('location').innerText = '深圳'; // 可根据城市 ID 写死或查表
            document.getElementById('condition').innerText = `${now.text} | 风向: ${now.windDir}`;
            document.getElementById('temp').innerText = now.temp;
        }

        // 3. 自动适配 Notion 的深色模式
        // Notion 嵌入网页时，如果用户开启了 Dark Mode，URL 通常会带有 theme=dark 参数
        function handleTheme() {
            const urlParams = new URLSearchParams(window.location.search);
            const isDark = urlParams.get('theme') === 'dark';
            const card = document.getElementById('weather-card');
            const loc = document.getElementById('location');
            const temp = document.getElementById('temp');

            if (isDark) {
                document.body.classList.add('dark');
                card.className = "p-4 rounded-xl border border-gray-700 bg-zinc-900/90 backdrop-blur-md shadow-sm max-w-sm mx-auto flex items-center justify-between";
                loc.className = "text-lg font-bold text-gray-200";
                temp.className = "text-3xl font-extrabold text-gray-100";
            }
        }

        // 初始化
        handleTheme();
        fetchWeather();
        // 每 30 分钟自动刷新一次数据
        setInterval(fetchWeather, 30 * 60 * 1000);
    </script>
</body>
</html>
